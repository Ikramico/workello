// ── New model: AuditLog ──────────────────────────────────────────────────────
// One row per action. Append-only — no UPDATE or DELETE ever touches this table.
// `actorId` is nullable so system-generated events (e.g. a digest run) can be
// logged without a user.
//
// model AuditLog {
//   id          String      @id @default(uuid())
//   workspaceId String
//   workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
//   actorId     String?
//   actor       User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
//   action      AuditAction
//   targetType  String?     // e.g. "card", "member", "repo" — human-readable context
//   targetId    String?     // id of the affected entity
//   targetLabel String?     // human-readable name at the time of the action
//   metadata    Json?       // any extra structured data (old value, new value, etc.)
//   createdAt   DateTime    @default(now())
//
//   @@index([workspaceId, createdAt(sort: Desc)])
//   @@index([actorId])
//   @@map("audit_logs")
// }

// ── Change to model LinkedRepo ───────────────────────────────────────────────
// Add one nullable field for per-repo webhook secret (HMAC key):
//
//   webhookSecret  String?   // encrypted at rest via EncryptionService
//
// When present, WebhooksService uses this instead of the global
// GITHUB_WEBHOOK_SECRET / GITLAB_WEBHOOK_SECRET env var.
// Null = fall back to the env var (backwards-compatible).

